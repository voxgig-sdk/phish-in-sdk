  "components": {
    "schemas": {
      "Show": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the show"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date of the show"
          },
          "venue_id": {
            "type": "integer",
            "description": "ID of the venue"
          },
          "venue_name": {
            "type": "string",
            "description": "Name of the venue"
          },
          "location": {
            "type": "string",
            "description": "Location of the venue"
          },
          "tour_id": {
            "type": "integer",
            "description": "ID of the tour"
          },
          "tour_name": {
            "type": "string",
            "description": "Name of the tour"
          },
          "tracks": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Track"
            }
          }
        }
      },
      "ShowsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "total_entries": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Show"
            }
          }
        }
      },
      "ShowResponse": {
        "type": "object",
