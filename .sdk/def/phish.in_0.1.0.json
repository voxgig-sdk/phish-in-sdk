            "type": "integer",
            "description": "Unique identifier for the song"
          },
          "title": {
            "type": "string",
            "description": "Title of the song"
          },
          "alias": {
            "type": "string",
            "description": "Alternative name or alias"
          },
          "times_played": {
            "type": "integer",
            "description": "Number of times the song has been played"
          },
          "debut": {
            "type": "string",
            "format": "date",
            "description": "Date of first performance"
          },
          "last_played": {
            "type": "string",
            "format": "date",
            "description": "Date of most recent performance"
          }
        }
