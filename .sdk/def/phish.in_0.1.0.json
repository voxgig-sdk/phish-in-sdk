      "SongsResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "total_entries": {
            "type": "integer"
          },
          "total_pages": {
            "type": "integer"
          },
          "page": {
            "type": "integer"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Song"
            }
          }
        }
      },
      "SongResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "data": {
            "$ref": "#/components/schemas/Song"
          }
        }
      },
      "Venue": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier for the venue"
          },
          "name": {
            "type": "string",
            "description": "Name of the venue"
          },
          "location": {
            "type": "string",
            "description": "Location (city, state/country)"
          },
          "shows_count": {
            "type": "integer",
            "description": "Number of shows at this venue"
          },
          "latitude": {
            "type": "number",
            "format": "float"
          },
          "longitude": {
            "type": "number",
            "format": "float"
