# Entity: track

main: kit: entity: track: {

  alias: field: {}

  fields: [
    {
      name: "duration"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "mp3"
      req: false
      type: "`$STRING`"
    }
    {
      name: "position"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "set"
      req: false
      type: "`$STRING`"
    }
    {
      name: "show_id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "song_id"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "title"
      req: false
      type: "`$STRING`"
    }
  ]

  id: {
    field: "id"
    name: "id"
  }

  name: "track"
  op: {
    load: {
      name: "load"
      points: [
        {
          args: {
            params: [
              {
                kind: "param"
                name: "id"
                orig: "id"
                reqd: true
                type: "`$INTEGER`"
              }
            ]
          }
          method: "GET"
          orig: "/tracks/{id}"
          parts: [
            "tracks"
            "{id}"
          ]
          select: {
            exist: [
              "id"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.data`"
          }
        }
      ]
    }
  }



}
